{
    "name": "herdwatch-oss/monolog-ecs-formatter",
    "description": "Monolog formatter and Symfony bundle that promotes typed ECS value objects (metrics, labels, text, tags, service, user, tracing, error) to top-level ECS-aligned JSON fields for clean Elasticsearch mapping, with a default copy mode that also keeps the legacy Monolog top-level keys (channel, level_name, level, datetime) so existing dashboards keep working during migration.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["monolog", "ecs", "elasticsearch", "logging", "symfony", "formatter"],
    "require": {
        "php": ">=8.3",
        "monolog/monolog": "^3.0",
        "psr/log": "^3.0",
        "symfony/config": "^7.0",
        "symfony/console": "^7.0",
        "symfony/dependency-injection": "^7.0",
        "symfony/http-kernel": "^7.0"
    },
    "require-dev": {
        "php-cs-fixer/shim": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Herdwatch\\MonologEcsFormatter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Herdwatch\\MonologEcsFormatter\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
