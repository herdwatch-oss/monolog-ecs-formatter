{
    "name": "herdwatch-oss/monolog-ecs-formatter",
    "description": "Monolog formatter and Symfony bundle that promotes structured log context (labels, metric, text, tags, service, error) to top-level ECS-aligned JSON fields for clean Elasticsearch mapping, with copy/move modes for non-destructive migration.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["monolog", "ecs", "elasticsearch", "logging", "symfony", "formatter"],
    "require": {
        "php": ">=8.3",
        "monolog/monolog": "^3.0",
        "psr/log": "^3.0",
        "symfony/config": "^7.0",
        "symfony/console": "^7.0",
        "symfony/dependency-injection": "^7.0",
        "symfony/http-kernel": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Herdwatch\\MonologEcsFormatter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Herdwatch\\MonologEcsFormatter\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
